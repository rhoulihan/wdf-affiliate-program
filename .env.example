# Laundromat Affiliate Program - Example Configuration
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=3000
NODE_ENV=development
ENABLE_DELETE_DATA_FEATURE=false
BAG_FEE=10.00

# Branding
# Display brand name (production sets this to the real business name; the
# committed repo stays mark-free, so production .env supplies the real value).
BRAND_DISPLAY_NAME=Laundromat
# Optional brand overrides (production sets these to the real values):
#   BRAND_SHORT_NAME     — short/compact brand name
#   BRAND_LEGAL_NAME     — legal entity (real owner), default 'CRHS Enterprises, LLC'
#   BRAND_INSTANCE_NAME  — lowercase instance slug
#   BRAND_LOGO_PATH      — site-relative logo image path
#   BRAND_OG_IMAGE_PATH  — site-relative OG/Twitter image path
# These resolve THIS app's brand AND @crhs/web-core's: web-core's cspHelper
# fills {{BRAND_*}} HTML tokens and the email transport/template-manager fill the
# From-name + [BRAND_*] template tokens — all reading these same env vars.
# PM2_APP_NAME=laundromat   # PM2 process name; deploy sets it to keep the live name

# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017/wavemax
# For MongoDB Atlas: Use your connection string
MONGODB_URI=mongodb://localhost:27017/wavemax

# Security Keys - IMPORTANT: Generate new keys for production!
# You can generate these using: openssl rand -hex 32
ENCRYPTION_KEY=your_encryption_key_here
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here
# Optional dedicated secret for the csrf-csrf double-submit token. Falls back
# to SESSION_SECRET, then JWT_SECRET, if not set. Setting a separate value is
# recommended so CSRF can be rotated without invalidating live sessions or JWTs.
CSRF_SECRET=your_csrf_secret_here

# Default Administrator Account
DEFAULT_ADMIN_EMAIL=admin@example.com

# Email Configuration - Choose one provider:

# Option 1: Console (for development/testing)
EMAIL_PROVIDER=console
# Sender address for outgoing mail. Production sets this per-deploy; the
# canonical no-reply sender is shown here as the example.
EMAIL_FROM=no-reply@crhsent.com

# Option 2: SMTP
#EMAIL_PROVIDER=smtp
#EMAIL_HOST=smtp.example.com
#EMAIL_PORT=587
#EMAIL_USER=your_email@example.com
#EMAIL_PASS=your_email_password
#EMAIL_FROM=noreply@example.com
#EMAIL_SECURE=false

# Option 3: Microsoft Exchange
#EMAIL_PROVIDER=exchange
#EXCHANGE_HOST=mail.example.com
#EXCHANGE_PORT=587
#EXCHANGE_USER=your_exchange_user
#EXCHANGE_PASS=your_exchange_password
#EXCHANGE_FROM_EMAIL=noreply@example.com
#EXCHANGE_REJECT_UNAUTHORIZED=true

# Alert Email for Monitoring (optional)
#ALERT_EMAIL=ops-team@example.com

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
# CORS_EXTRA_ORIGINS — additive allowlist consumed by @crhs/web-core's shared
# corsConfig. RESERVED: this app still uses its own inline CORS allowlist
# (deliberately narrower than web-core's — it does not re-admit the franchisor
# origins), so this var is currently informational. If/when CORS adoption lands,
# production sets: CORS_EXTRA_ORIGINS=https://portal.atxwashdryfold.com
#CORS_EXTRA_ORIGINS=https://portal.atxwashdryfold.com

# SESSION_COOKIE_NAME — base session cookie name for @crhs/web-core's shared
# session builder (__Host- prefixed automatically in production). RESERVED: this
# app still mounts session inline (its store handle is needed by the Oracle
# cursor diagnostics), and that inline block already hardcodes 'portal.sid', so
# this var is currently informational. Kept here to document the effective name.
#SESSION_COOKIE_NAME=portal.sid

# Base URL for the app (email links, canonical URLs). Production sets this
# per-deploy to the canonical portal host, shown here as the example.
BASE_URL=https://portal.atxwashdryfold.com

# Frontend URL (for password reset links, etc.)
FRONTEND_URL=http://localhost:3000

# Logging Configuration
LOG_LEVEL=debug
LOG_DIR=logs
# LOG_SERVICE_NAME — the Winston `service` tag. The logger now comes from
# @crhs/web-core, which uses its own generic default when this is unset; set it
# to 'crhs-portal' to preserve this app's historical log stream name.
LOG_SERVICE_NAME=crhs-portal

# Stripe API Keys (Optional - for payment processing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# AWS S3 Configuration (Optional - for storing bag barcodes)
AWS_S3_BUCKET=your-s3-bucket-name

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
RELAX_RATE_LIMITING=false

# Additional Settings
TRUST_PROXY=false
COOKIE_SECURE=false
CSRF_PHASE=3
SHOW_DOCS=true

# Service Area Configuration
SERVICE_STATE=TX
SERVICE_CITY=Austin
SERVICE_RADIUS_MILES=50

# Austin reference build — Google Places (browser-direct reviews fetch).
# The key is rendered into the browser by /assets/js/austin-host-mock-config.js
# at request time, so abuse is bounded by HTTP-referrer restrictions on the
# key itself — configure these in Google Cloud Console:
#   API restrictions:    Places API (New) only
#   Application restr.:  HTTP referrers (websites)
#                        https://rundberglaundry.com/*
#                        https://*.rundberglaundry.com/*
#                        https://wavemaxlaundry.com/*
#                        https://*.wavemaxlaundry.com/*
#                        http://localhost:*/*  (dev only)
#                        http://127.0.0.1:*/*  (dev only)
GOOGLE_PLACES_API_KEY=
# Server-side key for the Google Address Validation API — used to geocode +
# validate addresses for the partner customer-geolocation radius gate (bag
# registration). SEPARATE from GOOGLE_PLACES_API_KEY: this one is IP-restricted
# to the app servers (oci1/oci2 egress) and API-restricted to Address
# Validation. Never sent to the browser. Absent => geo gate fails open (allows).
GOOGLE_GEOCODING_API_KEY=
# Place ID for THIS franchisee (the value Hibu, Yext, and Google Maps all
# resolve to "Laundromat · 825 E Rundberg Ln F1, Austin, TX 78753").
# Find via Places API "Find Place from Text" or by searching the location
# on Google Maps and copying the `ChIJ...` token from the share URL.
GOOGLE_PLACES_LOCATION_PLACE_ID=
# Legacy alias — kept until any consumer of LOCATION_AUSTIN_TX_PLACE_ID is
# migrated. New code should read GOOGLE_PLACES_LOCATION_PLACE_ID instead.
LOCATION_AUSTIN_TX_PLACE_ID=

# Contact-form recipient — sourced from LOCATION_DATA, NOT env.
# server/controllers/contactController reads
# loadLocationData(slug).contact.email at runtime via the loader at
# server/config/locationData.js, which sandbox-evaluates the same
# IIFE the browser loads (public/assets/js/austin-host-mock-data.js
# for slug 'austin-tx'). To change where contact-form messages are
# sent, edit LOCATION_DATA.contact.email in that file. No env var
# is involved.
# ── Location quarantine ─────────────────────────────────────────────
# When 'true', this server only serves Austin location pages
# (/austin-tx/*), the affiliate-program app (API, embed pages, assets,
# legal pages), and the contact endpoint. All other requests
# 302-redirect to the corporate site (CORPORATE_SITE_URL), preserving
# the original path. Leave unset/false in local dev and tests.
QUARANTINE_NON_AUSTIN=false
# Target for quarantine redirects. Trailing slashes are stripped.
CORPORATE_SITE_URL=https://www.wavemaxlaundry.com

# ── Design Explorer (private franchisor review tool) ────────────────
# Shared access token gating /design-explorer/* (server/middleware/
# explorerGuard.js). Without a matching ?k=<token> (or explorer_k cookie)
# the explorer 404s and is noindex'd. Use a long random string; share
# https://rundberglaundry.com/design-explorer/index.html?k=<token>
# with reviewers. Leave unset to disable the tool entirely.
EXPLORER_TOKEN=
# Read-only token for the always-on in-store Order Expediter display
# (server/middleware/expediterGuard.js). The display authenticates with
# ?k=<token> (or the x-expediter-token header); without it the API 401s and
# the board shows nothing. Use a long random string and open
# https://rundberglaundry.com/embed-app-v2.html?route=/order-expediter&k=<token>
# on the store device. Leave unset to disable the expediter entirely (503).
EXPEDITER_TOKEN=
# API key for the live FAQ concierge (POST /api/concierge, Claude Haiku).
# When unset the concierge gracefully declines; the explorer still works.
ANTHROPIC_API_KEY=

# ── Firebase Phone Verification (PR 7) ─────────────────────────────
# Phone verification at bag-claim registration uses Firebase Phone Auth.
# The Web config below is PUBLIC (it ships in the registration page) — the
# values are the ones from the Firebase console "Web app" config block.
# Abuse protection is reCAPTCHA Enterprise + authorized domains, not secrecy.
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=wavemax-bag-registration.firebaseapp.com
FIREBASE_PROJECT_ID=wavemax-bag-registration
FIREBASE_STORAGE_BUCKET=wavemax-bag-registration.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
# Path to the Firebase Admin service-account JSON (SECRET — on-box, gitignored,
# never committed). The server uses it to verify phone ID tokens.
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
# Master switch: 'true' requires a verified phone to register; anything else
# (or unset) runs email-OTP only (phone collected, not verified).
PHONE_VERIFICATION_ENABLED=false
